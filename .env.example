# ── Asosiy frontend (mymarkaz-frontend) muhit o'zgaruvchilari ──
# Backend API manzili (oxirida /api bilan)
NEXT_PUBLIC_API_URL=http://localhost:3331/api

# Prod'da sayt manzili — middleware redirectlari uchun zaxira
# NEXT_PUBLIC_SITE_URL=https://mymarkaz.uz

# ── Obuna / to'lov bo'limi (Payme) ─────────────────────────────
# VAQTINCHA O'CHIQ. `true` qilinsa: /pricing, /billing, /billing/status
# marshrutlari ochiladi va navbarda "Tariflar" bandi paydo bo'ladi.
# ⚠️ Bu build-time flag — o'zgartirilgach frontend QAYTA BUILD qilinadi.
# Backendда ham `BILLING_ENABLED=true` bo'lishi shart (aks holda API 404).
NEXT_PUBLIC_BILLING_ENABLED=false
